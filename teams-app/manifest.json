{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "developer": {
    "name": "Company A",
    "websiteUrl": "https://{{PUBLIC_HOST}}",
    "privacyUrl": "https://{{PUBLIC_HOST}}/privacy",
    "termsOfUseUrl": "https://{{PUBLIC_HOST}}/terms"
  },
  "name": { "short": "Falcon", "full": "Falcon by Company A" },
  "description": {
    "short": "Ask about your sites' CCTV safety alerts.",
    "full": "Falcon answers questions about CCTV safety and operations alerts with numbers, charts, tables and the camera frames behind them. Type \"projects\" to switch project and \"help\" for examples."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#1D232A",
  "bots": [
    {
      "botId": "{{TEAMS_APP_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupChat"],
          "commands": [
            { "title": "help", "description": "What Falcon can answer" },
            { "title": "projects", "description": "Switch to another project" },
            { "title": "current", "description": "Show the project you're on" }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["{{PUBLIC_HOST}}"]
}
